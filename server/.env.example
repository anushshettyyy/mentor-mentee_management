# =============================================================================
# SUPABASE POSTGRESQL CONFIGURATION
# =============================================================================
# 1. DATABASE_URL: Supabase Transaction Pooler URL (port 6543)
#    Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Transaction mode)
#    Used by application runtime queries with connection pooling.
#    Note: Include ?pgbouncer=true if using PgBouncer pooler.
#    Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Supabase Direct Connection URL (port 5432)
#    Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Session mode / Direct)
#    Used by Prisma for schema push, migrations, and CLI management.
#    Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5000
JWT_SECRET="replace-with-a-strong-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
